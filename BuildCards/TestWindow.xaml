<Window x:Class="BuildCards.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:BuildCards.Controls.Cards"
        mc:Ignorable="d"
        Title="TestWindow" Height="450" Width="800">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border Padding="20,14"
                    Background="Gold"
                    CornerRadius="10">
                <!-- Typewriter TextBlock -->
                <TextBlock x:Name="TypewriterText"
                           FontFamily="Consolas"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Width="600"/>
            </Border>

            <!-- Your FlipCard stays here -->
            <cards:FlipCard Width="200"
                            Height="150"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

        </StackPanel>
    </Grid>
</Window>