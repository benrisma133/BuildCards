                                        <DoubleAnimation Storyboard.TargetName="HoverSkew" Storyboard.TargetProperty="AngleX" To="0" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
