<UserControl x:Class="BuildCards.Controls.Components.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BuildCards.Controls.Components"
             mc:Ignorable="d"
             x:Name="RootStatCard"
             MinWidth="220">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title + Optional Icon -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Title, ElementName=RootStatCard}"
                           Foreground="#6B7280"
                           FontSize="13"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Border x:Name="IconContainer"
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        CornerRadius="8"
                        Background="#F3F4F6"
                        Margin="10,0,0,0"
                        Visibility="Collapsed">
                    <Path x:Name="IconPath"
                          Data="{Binding IconData, ElementName=RootStatCard}"
                          Fill="#374151"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Row 1: Hero Metric Value -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Value, ElementName=RootStatCard}"
                       Foreground="#111827"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,12"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Row 2: Trend Badge + Comparison Subtitle -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <local:Badge x:Name="TrendBadge"
                             Text="{Binding TrendText, ElementName=RootStatCard}"
                             Variant="Success"
                             Margin="0,0,8,0"
                             Visibility="Collapsed"/>

                <TextBlock x:Name="SubtitleText"
                           Text="{Binding Subtitle, ElementName=RootStatCard}"
                           Foreground="#6B7280"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>