<UserControl x:Class="BuildCards.Controls.Components.SegmentedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             x:Name="RootSegmented"
             HorizontalAlignment="Left"
             VerticalAlignment="Center">

    <Border Background="#F3F4F6"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="10"
            Padding="4"
            SnapsToDevicePixels="True">

        <ItemsControl x:Name="SegmentsHost"
                      ItemsSource="{Binding ItemsSource, ElementName=RootSegmented}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="SegmentPill"
                            Background="Transparent"
                            CornerRadius="7"
                            Padding="16,7"
                            Cursor="Hand"
                            MouseLeftButtonUp="SegmentPill_MouseLeftButtonUp">
                        <TextBlock x:Name="SegmentLabel"
                                   Text="{Binding}"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>